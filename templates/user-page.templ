templ userHomepage(r *http.Request, user view.User, s *view.CurrentUser) {
	<div class="row mt-2 mb-2">
		<div class="col d-flex justify-content-center">
			<a href={ templ.SafeURL(fmt.Sprintf("https://bgm.tv/user/%d", user.ID)) }>
				<h4>
					{ fmt.Sprintf("https://bgm.tv/user/%d", user.ID) }
				</h4>
			</a>
		</div>
	</div>
	if s.SuperUser() {
		<div class="row mb-3">
			<div class="col d-flex justify-content-center">
				<form
					action={ templ.SafeURL(fmt.Sprintf("/api/reject-user-patches/%d", user.ID)) }
					method="post"
					class="d-flex flex-wrap gap-2 justify-content-center align-items-center"
					onsubmit="return confirm('确定要拒绝该用户所有待审核的 patch 吗？')"
				>
					<input type="hidden" name="x-csrf-token" value={ csrf.GetToken(r) }/>
					<input
						type="text"
						name="reason"
						class="form-control"
						placeholder="拒绝理由（可选）"
						style="max-width: 300px"
					/>
					<button type="submit" class="btn btn-danger">
						拒绝该用户所有待审核 patch
					</button>
				</form>
			</div>
		</div>
	}
}
